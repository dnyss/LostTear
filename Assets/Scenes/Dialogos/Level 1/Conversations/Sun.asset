  m_Script: {fileID: 11500000, guid: 9f06d2c298655974b9e76112768deb31, type: 3}
  m_Name: Sun
  m_EditorClassIdentifier: 
  EndedDialogo: 1
  FinalConversation: {fileID: 0}
  speakerLeft: {fileID: 11400000, guid: a80ab6898e7d87b46bdeb26950b8b325, type: 2}
  speakerRight: {fileID: 11400000, guid: 9d8cbafc96482eb4eb1f1fb46b007908, type: 2}
  lines:
  - character: {fileID: 11400000, guid: 9d8cbafc96482eb4eb1f1fb46b007908, type: 2}
    text: Hello, little one.
  - character: {fileID: 11400000, guid: 9d8cbafc96482eb4eb1f1fb46b007908, type: 2}
    text: I've seen you come up all the way here.
  - character: {fileID: 11400000, guid: 9d8cbafc96482eb4eb1f1fb46b007908, type: 2}
    text: You seem to travel without a purpose.
  - character: {fileID: 11400000, guid: 9d8cbafc96482eb4eb1f1fb46b007908, type: 2}
    text: If that's the case, can you help me with something?
  - character: {fileID: 11400000, guid: 9d8cbafc96482eb4eb1f1fb46b007908, type: 2}
    text: If I moved all the things tangled in my hair would fall.
  - character: {fileID: 11400000, guid: 9d8cbafc96482eb4eb1f1fb46b007908, type: 2}
    text: Could you talk to the universe for me?
  - character: {fileID: 11400000, guid: 9d8cbafc96482eb4eb1f1fb46b007908, type: 2}
    text: I'll put you closer to her. I'm sure you'll find a way to help.
  question: {fileID: 0}
  nextConversation: {fileID: 0}
