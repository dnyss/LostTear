  FinalConversation: {fileID: 11400000, guid: 1ffb085b8dd51e04eb52bfed94ca0be1, type: 2}
  speakerLeft: {fileID: 11400000, guid: cdc82d7ce127d8740bc5973abd620e6c, type: 2}
  speakerRight: {fileID: 11400000, guid: a80ab6898e7d87b46bdeb26950b8b325, type: 2}
  lines:
  - character: {fileID: 11400000, guid: a80ab6898e7d87b46bdeb26950b8b325, type: 2}
    text: Have you seen the yellow strands that hang around here?
  - character: {fileID: 11400000, guid: a80ab6898e7d87b46bdeb26950b8b325, type: 2}
    text: That's Sun's hair, everything is tangled in it.
  - character: {fileID: 11400000, guid: a80ab6898e7d87b46bdeb26950b8b325, type: 2}
    text: If it wasn't for it everything would've fallen already.
